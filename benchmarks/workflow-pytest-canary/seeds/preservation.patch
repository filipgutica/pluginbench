+        source = """
+            def test_fail():
+                try:
+                    try:
+                        raise ValueError(11)
+                    except Exception as e:
+                        raise ValueError(12){raise_from}
+                except Exception as e:
+                    raise ValueError(13){raise_from}
+        """.format(raise_from=" from e" if raise_from else "")
+        reprec = testdir.inline_runsource(source)
+        rep = reprec.getreports("pytest_runtest_logreport")[1]
+
+        data = rep._to_json()
+        assert len(data["longrepr"]["chain"]) == 3
+        newrep = TestReport._from_json(data)
+
+        assert newrep.longreprtext == rep.longreprtext
+
