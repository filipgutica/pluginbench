+    @pytest.mark.parametrize("from_clause", [" from e1", ""])
+    def test_xdist_report_chained_exception(self, testdir, from_clause):
+        testdir.makepyfile(
+            """
+            def test_chained_exception():
+                try:
+                    try:
+                        raise ValueError(11)
+                    except Exception as e1:
+                        raise ValueError(12){from_clause}
+                except Exception as e2:
+                    raise ValueError(13) from e2
+        """.format(from_clause=from_clause)
+        )
+        reports = testdir.inline_run().getreports("pytest_runtest_logreport")
+        report = reports[1]
+
+        data = report._to_json()
+        new_report = TestReport._from_json(data)
+
+        assert new_report.longreprtext == report.longreprtext
+        assert "ValueError: 11" in new_report.longreprtext
+        assert "ValueError: 12" in new_report.longreprtext
+        assert "ValueError: 13" in new_report.longreprtext
